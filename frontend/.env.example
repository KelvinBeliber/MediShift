# The Node API base URL. The backend's CORS allowlist is a single origin
# (CLIENT_URL in backend/.env, default http://localhost:5173) — if you change
# the Vite dev port, change CLIENT_URL to match or every request will fail.
VITE_API_URL=http://localhost:5000/api/v1

# Socket.io connects to the server root, not the /api/v1 prefix.
VITE_SOCKET_URL=http://localhost:5000
