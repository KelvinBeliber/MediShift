NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/medishift

JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=changeme_cookie_secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MediShift <no-reply@medishift.com>

REDIS_URL=

SCHEDULING_SERVICE_URL=http://localhost:8000
SCHEDULING_SERVICE_API_KEY=changeme_scheduling_api_key

# AI Assistant (optional). Without a key the feature reports itself
# unconfigured and the rest of the app is unaffected.
#
# ASSISTANT_MODEL and ASSISTANT_MAX_TOKENS are optional overrides — the values
# shown are the defaults the server uses when they are unset. ASSISTANT_MAX_TOKENS
# is a ceiling on thinking *and* answer text together, so it needs more headroom
# than the length of the answers alone would suggest.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-6
ASSISTANT_MAX_TOKENS=8192
